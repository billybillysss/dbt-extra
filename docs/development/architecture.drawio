        <UserObject id="dbt-inputs" label="dbt project" tooltip="Native dbt_project.yml, authored SQL, macros, properties YAML, seeds and snapshots. Optional existing manifest/catalog artifacts are evidence, never reconstructed source.">
          <mxCell style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;convertToSvg=1;fillColor=#f9fafb;strokeColor=#d0d5dd;strokeWidth=1.5;fontFamily=Helvetica;fontSize=21;fontColor=#344054;spacing=16;" vertex="1" parent="1">
            <mxGeometry x="80" y="120" width="240" height="72" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="project-loading" label="Project loading" tooltip="CLI and Python entry points use operation-local project snapshots. Discover resources, select scope and resolve source locations. Stable resource IDs are distinct from directory paths.">
          <mxCell style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;convertToSvg=1;fillColor=#f9fafb;strokeColor=#d0d5dd;strokeWidth=1.5;fontFamily=Helvetica;fontSize=21;fontColor=#344054;spacing=16;" vertex="1" parent="1">
            <mxGeometry x="440" y="120" width="240" height="72" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="shared-analysis" label="SQL &amp;amp; analysis" tooltip="Shared SQLGlot and Jinja AST analysis: bounded static macro interpretation, references, dependencies, query scopes, types, value lineage and explicit coverage reasons. Independent of review-file serializers. No arbitrary template execution.">
          <mxCell style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;convertToSvg=1;fillColor=#f2f4f7;strokeColor=#d0d5dd;strokeWidth=1.5;fontFamily=Helvetica;fontSize=21;fontStyle=1;fontColor=#344054;spacing=16;" vertex="1" parent="1">
            <mxGeometry x="80" y="260" width="960" height="72" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="read-workflows" label="Inspect &amp;amp; validate" tooltip="Read-only workflows: expand upstream logic, prune columns, explain SQL/logical plans, and check structure, references and cycles. Logical plans are not warehouse execution plans.">
          <mxCell style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;convertToSvg=1;fillColor=#ffffff;strokeColor=#d0d5dd;strokeWidth=1.5;fontFamily=Helvetica;fontSize=20;fontColor=#344054;spacing=16;" vertex="1" parent="1">
            <mxGeometry x="80" y="400" width="240" height="72" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="edit-workflows" label="Optimize &amp;amp; enrich" tooltip="Conservative authored-SQL rewrites and enrichment propose SQL/YAML changes through ChangeSet; library workflows do not implicitly write source files.">
          <mxCell style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;convertToSvg=1;fillColor=#ffffff;strokeColor=#d0d5dd;strokeWidth=1.5;fontFamily=Helvetica;fontSize=20;fontColor=#344054;spacing=16;" vertex="1" parent="1">
            <mxGeometry x="440" y="400" width="240" height="72" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="review-workflows" label="Review exchange" tooltip="Export review files with baselines and cell/source bindings. Import validates supported XLSX/CSV edits, stable identities and conflicts before proposing source changes. Export writes review files only, never authored source, and never prunes.">
          <mxCell style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;convertToSvg=1;fillColor=#ffffff;strokeColor=#d0d5dd;strokeWidth=1.5;fontFamily=Helvetica;fontSize=20;fontColor=#344054;spacing=16;" vertex="1" parent="1">
            <mxGeometry x="800" y="400" width="240" height="72" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="proposed-changes" label="Proposed changes" tooltip="ChangeSet collects proposed source edits. Callers may inspect diffs(). CLI preview shows diffs without writes. Preview is optional, not a mandatory approval gate; non-preview CLI commands apply by default.">
          <mxCell style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;convertToSvg=1;fillColor=#eef4ff;strokeColor=#a9bfe2;strokeWidth=1.5;fontFamily=Helvetica;fontSize=21;fontColor=#294d80;spacing=16;" vertex="1" parent="1">
            <mxGeometry x="440" y="540" width="240" height="72" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="review-files" label="Review files&lt;br&gt;&lt;font style=&quot;font-size:16px;color:#667085&quot;&gt;XLSX · CSV&lt;/font&gt;" tooltip="XLSX/CSV support a checked, supported-field round-trip. JSON is an additional read-only analysis export; JSON is not imported.">
          <mxCell style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;convertToSvg=1;fillColor=#f9fafb;strokeColor=#d0d5dd;strokeWidth=1.5;fontFamily=Helvetica;fontSize=20;fontColor=#344054;spacing=12;" vertex="1" parent="1">
            <mxGeometry x="800" y="540" width="240" height="72" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject id="checked-apply" label="Checked apply&lt;br&gt;&lt;font style=&quot;font-size:16px;color:#5479b5&quot;&gt;SQL / YAML&lt;/font&gt;" tooltip="Apply writes the original authored dbt SQL/YAML. Recheck input snapshots and safe paths, stage sibling temporary files, replace targets and attempt rollback on failure. No crash-safe transaction or concurrency lock is claimed.">
          <mxCell style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;convertToSvg=1;fillColor=#eef4ff;strokeColor=#5479b5;strokeWidth=1.5;fontFamily=Helvetica;fontSize=21;fontStyle=1;fontColor=#294d80;spacing=12;" vertex="1" parent="1">
            <mxGeometry x="440" y="680" width="240" height="80" as="geometry" />
          </mxCell>
        </UserObject>

